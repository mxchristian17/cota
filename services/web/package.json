{
  "name": "cota",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free, open-source 2D and 3D CAD that runs in the browser",
  "license": "Apache-2.0",
  "author": "Christian Orengia (https://github.com/mxchristian17)",
  "homepage": "https://mxchristian17.github.io/cota/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxchristian17/cota.git",
    "directory": "services/web"
  },
  "bugs": {
    "url": "https://github.com/mxchristian17/cota/issues"
  },
  "keywords": [
    "cad",
    "2d",
    "3d",
    "drafting",
    "modeling",
    "dwg",
    "dxf",
    "threejs",
    "webgl",
    "engineering",
    "technical-drawing",
    "browser"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-bvh-csg": "^0.0.16",
    "three-mesh-bvh": "^0.7.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.4.11",
    "vitest": "^5.0.5"
  }
}
