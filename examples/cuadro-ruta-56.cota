:"TEXT","layer":"0","props":{"position":[18,96,0],"height":2.3,"rotation":0,"text":"1. Puntera derecha: patilla M10×1 (broca Ø9); ranura del eje 10,1 abierta hacia abajo, 20° adelante;","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e159","type":"TEXT","layer":"0","props":{"position":[18,91.8,0],"height":2.3,"rotation":0,"text":"radios del contorno tangentes. Puntera izquierda igual, sin patilla. Corte láser, aristas rotas 0,3.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e160","type":"TEXT","layer":"0","props":{"position":[18,87.6,0],"height":2.3,"rotation":0,"text":"2. Caja: Ø40 × 68, interior Ø33,6 (menor de la rosca BSA 1,370\"×24 TPI, lado transmisión izquierda);","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e161","type":"TEXT","layer":"0","props":{"position":[18,83.4,0],"height":2.3,"rotation":0,"text":"agujero M5 abajo (broca Ø4,2) para la guía de cables.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e162","type":"TEXT","layer":"0","props":{"position":[18,79.2,0],"height":2.3,"rotation":0,"text":"3. Puente de freno Ø12,7 × 0,9 con agujero Ø6 pasante a 347 del eje trasero; puente de vainas Ø16 × 0,9.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e163","type":"TEXT","layer":"0","props":{"position":[18,75,0],"height":2.3,"rotation":0,"text":"Extremos copiados a los tirantes y a las vainas (ver CR56-01).","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e164","type":"TEXT","layer":"0","props":{"position":[18,70.8,0],"height":2.3,"rotation":0,"text":"4. Medidas en mm. Tolerancias generales ISO 2768-m.","justify":"left","normal":[0,0,1],"kind":"text"}}],"initialized":true}],"dimStyles":[{"name":"IRAM 4513","vars":{"DIMCLRD":null,"DIMLWD":null,"DIMDLE":0,"DIMDLI":7,"DIMSD1":false,"DIMSD2":false,"DIMCLRE":null,"DIMLWE":null,"DIMEXE":2,"DIMEXO":1,"DIMFXLON":false,"DIMFXL":1,"DIMSE1":false,"DIMSE2":false,"DIMBLK1":"_IRAM","DIMBLK2":"_IRAM","DIMLDRBLK":"_IRAM","DIMASZ":2.5,"DIMCEN":2.5,"DIMARCSYM":0,"DIM