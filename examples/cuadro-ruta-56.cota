"}},{"id":"e82","type":"TEXT","layer":"0","props":{"position":[292,239.3,0],"height":2.3,"rotation":0,"text":"Tirantes Ø16 → Ø12,7 × 0,7","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e83","type":"TEXT","layer":"0","props":{"position":[292,235.275,0],"height":2.3,"rotation":0,"text":"Puente freno Ø12,7 × 0,9   Puente vainas Ø16 × 0,9","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e84","type":"TEXT","layer":"0","props":{"position":[292,229.25,0],"height":3,"rotation":0,"text":"NOTAS","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e85","type":"TEXT","layer":"0","props":{"position":[292,224,0],"height":2.3,"rotation":0,"text":"1. Caja BSA 1,370\"×24 TPI, lado transmisión rosca izquierda;","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e86","type":"TEXT","layer":"0","props":{"position":[292,219.975,0],"height":2.3,"rotation":0,"text":"M5 abajo para la guía de cables. Repasar rosca y frentear.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e87","type":"TEXT","layer":"0","props":{"position":[292,215.95,0],"height":2.3,"rotation":0,"text":"2. Dirección 1-1/8\" recta: alojar Ø33,95 × 12 en ambos","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e88","type":"TEXT","layer":"0","props":{"position":[292,211.925,0],"height":2.3,"rotation":0,"text":"extremos (cazoletas EC34) y frentear después de soldar.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e89","type":"TEXT","layer":"0","props":{"position":[292,207.9,0],"height":2.3,"rotation":0,"text":"3. Escariar el asiento a Ø27,2 después de soldar; ranura","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e90","type":"TEXT","layer":"0","props":{"position":[292,203.875,0],"height":2.3,"rotation":0,"text":"1,6 × 16 atrás con alivio Ø3; abrazadera Ø28,6.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e91","type":"TEXT","layer":"0","props":{"position":[292,199.85,0],"height":2.3,"rotation":0,"text":"4. Punteras verticales e = 5, eje QR 130; patilla de cambio","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e92","type":"TEXT","layer":"0","props":{"position":[292,195.825,0],"height":2.3,"rotation":0,"text":"M10×1 (derecha). Freno de llanta: agujero Ø6 del puente","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e93","type":"TEXT","layer":"0","props":{"position":[292,191.8,0],"height":2.3,"rotation":0,"text":"a 347 del eje trasero (pinzas de alcance 39–49).","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e94","type":"TEXT","layer":"0","props":{"position":[292,187.775,0],"height":2.3,"rotation":0,"text":"5. Paso de cubierta hasta 700×25; plato hasta 53 dientes","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e95","type":"TEXT","layer":"0","props":{"position":[292,183.75,0],"height":2.3,"rotation":0,"text":"con línea de cadena 43,5.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e96","type":"TEXT","layer":"0","props":{"position":[292,179.725,0],"height":2.3,"rotation":0,"text":"6. Soldadura TIG, aporte ER70S-2. Alinear en mesa.","justify":"left","normal":[0,0,1],"kind":"text"}},{"id":"e97","type":"TEXT","layer":"0","props":{"position":[292,175.7,0],"height":2.3,"rotation":0,"text":"7. Masa del cuadro ≈ 1,95 kg (sin pintura ni abrazadera).","justify":"left","normal":[0,0,1],"kind":"text"}}],"initialized":true},{"id":"L3","name":"CR56-02 Detalles","pageSetup":{"paper":"A3","orientation":"landscape","marginsMm":[5,5,5,5],"plotStyle":"color","plotLineweights":true,"paperspaceLast":false,"hidePaperspaceObjects":false},"entities":[{"id":"e120","type":"RECTANGLE","layer":"0","props":{"corner":[5,5,0],"width":410,"height":287}},{"id":"e121","type":"INSERT","layer":"0","props":{"name":"TITLE_BLOCK","position":[415,5,0],"scale":[1,1,1],"rotation":0,"attributes":[{"tag":"COMPANY","value":"%<\\AcVar CustomDP.Company>%"},{"tag":"DRAWN","value":"%<\\AcVar Author>%"},{"tag":"TITLE","value":"CUADRO RUTA 56 – DETALLES"},{"tag":"DWG_NO","value":"CR56-02"},{"tag":"CHECKED","value":"—"}